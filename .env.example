PORT=8095
HOST=0.0.0.0
# Opções de dispositivo: cuda:0, mps, cpu ou auto
DEVICE=auto
# No Linux com setup Dual-GPU, isola a GPU NVIDIA (GTX 1660)
CUDA_VISIBLE_DEVICES=0
LOG_LEVEL=INFO
MODEL_PATH=models/yolov8n.pt
CONFIG_PATH=config/cameras.json
DATA_DIR=data
CONFIDENCE_THRESHOLD=0.65
IOU_THRESHOLD=0.45

# Anti-Duplicação e Debounce Inteligente
# Tempo de espera (em segundos) para alertar a mesma pessoa/entidade na mesma câmera
ALERT_COOLDOWN_SECONDS=45.0
# Número de frames consecutivos necessários para confirmar presença antes de alertar
MIN_CONSECUTIVE_FRAMES=6

# Aceleração de Hardware Máxima (NVIDIA GTX 1660)
# Ativa inferência com engine TensorRT FP16 (latência ~3ms)
USE_TENSORRT=true
ENGINE_PATH=models/yolov8n.engine

PORT=8095
HOST=0.0.0.0
# Opções de dispositivo: cuda:0, mps, cpu ou auto
DEVICE=auto
# No Linux com setup Dual-GPU, isola a GPU NVIDIA (GTX 1660)
CUDA_VISIBLE_DEVICES=0
LOG_LEVEL=INFO
MODEL_PATH=models/yolov8n.pt
CONFIG_PATH=config/cameras.json
DATA_DIR=data
CONFIDENCE_THRESHOLD=0.40
IOU_THRESHOLD=0.45

# Anti-Duplicação e Debounce Inteligente
# Tempo de espera (em segundos) para alertar a mesma pessoa/entidade na mesma câmera
ALERT_COOLDOWN_SECONDS=15.0
# Número de frames consecutivos necessários para confirmar presença antes de alertar
MIN_CONSECUTIVE_FRAMES=2

# Aceleração de Hardware Máxima (NVIDIA GTX 1660)
# Ativa inferência com engine TensorRT FP16 (latência ~3ms)
USE_TENSORRT=true
ENGINE_PATH=models/yolov8n.engine
FACENET_ENGINE_PATH=models/facenet.engine

# Decodificação de Vídeo em Hardware na GPU (NVIDIA NVDEC)
# Descompacta streams H.264/H.265 diretamente no chip NVDEC da GPU sem consumir CPU
USE_NVDEC=true
NVDEC_DEVICE=0

# Resolução do Stream Web (Server-Side Streaming)
# 1440 = Quad HD (texto e detalhes cristalinos); 0 = resolução 2K/4K nativa da câmera
STREAM_MAX_WIDTH=1440
STREAM_QUALITY=85

# =========================================================================
# BOT 1: FEED GERAL DO TELEGRAM (Geralmente silenciado para conferência manual)
# =========================================================================
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=8835404499:AAEBA1ML9VWDhqc6z3hqNg4y8KbiPcX5J9A
TELEGRAM_CHAT_ID=1568885690
TELEGRAM_NOTIFY_PERSON=true
TELEGRAM_NOTIFY_VEHICLE=true
TELEGRAM_FACES_ONLY=true

# =========================================================================
# BOT 2: ALERTAS CRÍTICOS & AUDITOR DE IA (OPENROUTER)
# =========================================================================
# O Bot Crítico opera com som ativo e recebe APENAS eventos avaliados como risco ALTO pela IA
TELEGRAM_CRITICAL_ENABLED=false
TELEGRAM_CRITICAL_BOT_TOKEN=8986482854:AAETA17PoS2iwVq5V5iW3i-NJPQIn_B1hJk
TELEGRAM_CRITICAL_CHAT_ID=1568885690

# Chave de API do OpenRouter e modelo para o Avaliador de Suspeição e Risco Contextual
OPENROUTER_API_KEY=
# Modelos sugeridos: google/gemini-2.5-flash (ultrarrápido e barato), deepseek/deepseek-chat, meta-llama/llama-3.1-8b-instruct
OPENROUTER_MODEL=minimax/minimax-m3.1-flash:free

# =========================================================================
# MÓDULO USINA SOLAR: INTEGRAÇÃO FUSIONSOLAR KIOSK
# =========================================================================
FUSIONSOLAR_ENABLED=true
FUSIONSOLAR_API_URL=http://localhost:9666
FUSIONSOLAR_KIOSK_URL=https://intl.fusionsolar.huawei.com/pvmswebsite/nologin/assets/build/cloud.html#/kiosk?kk=EM6wrnyAhBtOFvD7rdNu045xGpwb1bGD
FUSIONSOLAR_CACHE_SECONDS=90

